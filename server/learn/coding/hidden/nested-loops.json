    "testCases": [
      {
        "testIndex": 1,
        "input": "3 4",
        "expectedOutput": "0,0 0,1 0,2 0,3\n1,0 1,1 1,2 1,3\n2,0 2,1 2,2 2,3",
        "isHidden": false
      },
      {
        "testIndex": 2,
        "input": "1 1",
        "expectedOutput": "0,0",
        "isHidden": false
      },
      {
        "testIndex": 3,
        "input": "4 2",
        "expectedOutput": "0,0 0,1\n1,0 1,1\n2,0 2,1\n3,0 3,1",
        "isHidden": false
      },
      {
        "testIndex": 4,
        "input": "1 5",
        "expectedOutput": "0,0 0,1 0,2 0,3 0,4",
        "isHidden": true
      },
      {
        "testIndex": 5,
        "input": "5 1",
        "expectedOutput": "0,0\n1,0\n2,0\n3,0\n4,0",
        "isHidden": true
      },
      {
        "testIndex": 6,
        "input": "2 2",
        "expectedOutput": "0,0 0,1\n1,0 1,1",
        "isHidden": true
      },
      {
        "testIndex": 7,
        "input": "5 5",
        "expectedOutput": "0,0 0,1 0,2 0,3 0,4\n1,0 1,1 1,2 1,3 1,4\n2,0 2,1 2,2 2,3 2,4\n3,0 3,1 3,2 3,3 3,4\n4,0 4,1 4,2 4,3 4,4",
        "isHidden": true
      },
      {
        "testIndex": 8,
        "input": "3 3",
        "expectedOutput": "0,0 0,1 0,2\n1,0 1,1 1,2\n2,0 2,1 2,2",
        "isHidden": true
      },
      {
        "testIndex": 9,
        "input": "2 5",
        "expectedOutput": "0,0 0,1 0,2 0,3 0,4\n1,0 1,1 1,2 1,3 1,4",
        "isHidden": true
      },
      {
        "testIndex": 10,
        "input": "4 4",
        "expectedOutput": "0,0 0,1 0,2 0,3\n1,0 1,1 1,2 1,3\n2,0 2,1 2,2 2,3\n3,0 3,1 3,2 3,3",
        "isHidden": true
      },
      {
        "testIndex": 11,
        "input": "5 3",
        "expectedOutput": "0,0 0,1 0,2\n1,0 1,1 1,2\n2,0 2,1 2,2\n3,0 3,1 3,2\n4,0 4,1 4,2",
        "isHidden": true
      },
      {
        "testIndex": 12,
        "input": "3 1",
        "expectedOutput": "0,0\n1,0\n2,0",
        "isHidden": true
      },
      {
        "testIndex": 13,
        "input": "1 3",
        "expectedOutput": "0,0 0,1 0,2",
        "isHidden": true
      }
    ]
  }
