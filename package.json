{
  "name": "kalvi-learn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "tsc -b",
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:sandbox-worker && npm run build:api && npm run build:submit && npm run build:feedback && npm run build:teamsync && npm run build:teamsync-webhook && npm run build:campus && npm run build:super-admin && npm run check:bundle && npm run check:api-startup",
    "build:sandbox-worker": "esbuild src/server/sandboxWorker.ts --bundle --platform=node --format=esm --target=node18 --external:pyodide --outfile=api/_sandbox-worker.mjs",
    "build:api": "esbuild src/server/apiHandler.ts --bundle --platform=node --format=esm --target=node18 --outfile=api/execute.js",
    "build:submit": "esbuild src/server/submitHandler.ts --bundle --platform=node --format=esm --target=node18 --outfile=api/submit.js",
    "build:feedback": "esbuild src/server/feedbackHandler.ts --bundle --platform=node --format=esm --target=node18 --outfile=api/feedback.js",
    "build:teamsync": "esbuild src/server/teamSyncHandler.ts --bundle --platform=node --format=esm --target=node18 --outfile=api/integrations/teamsync/tickets.js",
    "build:teamsync-webhook": "esbuild src/server/teamSyncWebhookHandler.ts --bundle --platform=node --format=esm --target=node18 --outfile=api/integrations/teamsync/webhooks.js",
    "build:campus": "node scripts/build-campus.mjs",
    "build:super-admin": "node scripts/build-super-admin.mjs",
    "test:super-admin": "npx tsx scripts/test-super-admin.ts",
    "test": "npx tsx scripts/test-evaluation-pipeline.ts",
    "test:perf": "npx tsx scripts/test-performance-audit.ts",
    "test:auth": "npx tsx scripts/test-auth-flow.ts",
    "test:streak": "npx tsx scripts/test-streak.ts",
    "test:feedback": "npx tsx scripts/test-frontend-feedback-ui.ts",
    "test:backend-feedback": "npx tsx scripts/test-backend-feedback.ts",
    "test:teamsync": "npx tsx scripts/test-teamsync-integration.ts",
    "test:teamsync-webhook": "npx tsx scripts/test-teamsync-webhook.ts",
    "test:teamsync-sender": "npx tsx scripts/test-teamsync-webhook-sender.ts",
    "test:security": "npx tsx scripts/test-security-hardening.ts",
    "test:pyodide-security": "npx tsx scripts/test-pyodide-security.ts",
    "test:pyodide-limits": "npx tsx scripts/test-pyodide-resource-limits.ts",
    "check:bundle": "node scripts/check-bundle-no-hidden-tests.cjs",
    "check:api-startup": "node scripts/check-api-startup.mjs",
    "test:multilang": "npx tsx scripts/test-multilang-revision.ts",
    "test:practice-import": "npx tsx scripts/test-imported-practice.ts",
    "test:practice-e2e": "npx tsx scripts/test-e2e-practice-execution.ts",
    "test:practice-local": "npx tsx scripts/test-practice-local-pass-count.ts",
    "test:mentor-auth": "npx tsx scripts/test-mentor-auth-student-view.ts",
    "test:mentor-solved": "npx tsx scripts/test-mentor-solved-challenges.ts",
    "test:campus-manager": "npx tsx scripts/test-campus-manager-audit.ts",
    "test:campus-users": "npx tsx scripts/test-campus-user-management.ts",
    "test:problem-stats": "npx tsx scripts/test-problem-stats.ts",
    "test:dashboard-stats": "npx tsx scripts/test-dashboard-stats-audit.ts",
    "test:total-solved-card": "npx tsx scripts/test-total-solved-card.ts",
    "test:dashboard-no-belts": "npx tsx scripts/test-dashboard-no-belts.ts",
    "test:revise-lang": "npx tsx scripts/test-revise-language-selector.ts",
    "test:profile-cleanup": "npx tsx scripts/test-profile-no-belts-difficulty.ts",
    "test:editor-restrictions": "npx tsx scripts/test-code-editor-restrictions.ts",
    "test:coding": "npx tsx scripts/test-coding-section.ts",
    "validate:coding-judge": "npx tsx scripts/validate-coding-judge-data.ts",
    "build:coding-bank": "npx tsx scripts/build-coding-bank.ts",
    "test:audit": "npx tsx scripts/test-master-audit.ts",
    "test:judge": "npx tsx scripts/test-judge-pipeline.ts",
    "test:judge-audit": "npx tsx scripts/test-judge-bank-audit.ts",
    "test:judge-oracle": "python scripts/judge_oracle.py",
    "test:practice-oracle": "python scripts/practice_oracle.py",
    "test:judge-all": "npx tsx scripts/test-judge-all-questions.ts",
    "test:learn-separation": "npx tsx scripts/test-learn-practice-separation.ts",
    "test:audited": "npx tsx scripts/test-audited-question-banks.ts",
    "test:language-availability": "npx tsx scripts/test-learn-language-availability.ts",
    "test:all": "npm test && npm run test:learn-separation && npm run test:audited && npx tsx scripts/test-no-migration-safety.ts && npm run test:judge-audit && npm run test:judge && npm run test:judge-oracle && npm run test:practice-oracle && npm run test:judge-all && npm run test:practice-local && npm run test:mentor-auth && npm run test:coding && npm run test:auth && npm run test:streak && npm run test:feedback && npm run test:backend-feedback && npm run test:teamsync && npm run test:teamsync-webhook && npm run test:teamsync-sender && npm run test:multilang && npm run test:security && npm run test:pyodide-security && npm run test:pyodide-limits && npm run test:practice-import && npm run test:practice-e2e && npm run test:problem-stats && npm run test:dashboard-stats && npm run test:audit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.115.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "pyodide": "^314.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
