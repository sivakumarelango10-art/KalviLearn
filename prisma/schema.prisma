generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Belt {
  id          String    @id @default(uuid())
  order       Int       @unique
  name        String    // e.g. "Belt 1", "Belt 2", "Belt 3"
  title       String    // e.g. "Programming Foundations"
  description String
  color       String
  problems    Problem[]
  createdAt   DateTime  @default(now())
}

model Problem {
  id                 String               @id @default(uuid())
  beltId             String?
  belt               Belt?                @relation(fields: [beltId], references: [id], onDelete: Cascade)
  learningUnitId     String?
  learningUnit       LearningUnit?        @relation(fields: [learningUnitId], references: [id], onDelete: Cascade)
  order              Int
  title              String
  slug               String               @unique
  difficulty         String               // "Easy" | "Medium" | "Hard"
  status                String               @default("PUBLISHED") // "DRAFT" | "PENDING_REVIEW" | "PUBLISHED" | "ARCHIVED"
  approvalStatus        String               @default("APPROVED") // "DRAFT" | "PENDING_REVIEW" | "APPROVED" | "REJECTED"
  submittedForReviewAt  DateTime?
  submittedForReviewBy  String?
  publishedAt           DateTime?
  publishedBy           String?
  reviewNotes           String?              @db.Text
  description        String               @db.Text
  inputFormat        String               @db.Text
  outputFormat       String               @db.Text
  explanation        String?              @db.Text
  exampleExplanation String?              @db.Text
  examples           Json?
  subdivision        String?
  starterCodes       Json
  isActive           Boolean              @default(true)
  timeLimitMs        Int                  @default(2000)
  memoryLimitMb      Int                  @default(256)
  canonicalProblemId String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  testCases          TestCase[]
  problemExamples    ProblemExample[]
  problemTestCases   ProblemTestCase[]
  problemStarterCodes ProblemStarterCode[]
  problemRevisions   ProblemRevision[]
  submissions        Submission[]
  userProgress       UserProgress[]

  @@index([beltId])
  @@index([learningUnitId])
  @@index([isActive])
  @@index([status])
}

model ProblemExample {
  id             String   @id @default(uuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String   @db.Text
  expectedOutput String   @db.Text
  explanation    String?  @db.Text
  displayOrder   Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([problemId, displayOrder])
}

model ProblemTestCase {
  id             String   @id @default(uuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String   @db.Text
  expectedOutput String   @db.Text
  isHidden       Boolean  @default(false)
  displayOrder   Int      @default(1)
  points         Int      @default(10)
  explanation    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([problemId, displayOrder])
  @@index([problemId, isHidden])
}

model ProblemStarterCode {
  id        String   @id @default(uuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language  String   // e.g. "python", "javascript", "cpp", "java"
  code      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([problemId, language])
  @@index([problemId])
}

model ProblemRevision {
  id            String   @id @default(uuid())
  problemId     String
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  version       Int      @default(1)
  snapshot      Json
  changedBy     String?
  changeSummary String?
  createdAt     DateTime @default(now())

  @@index([problemId, version])
}

model TestCase {
  id             String  @id @default(uuid())
  problemId      String
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  testIndex      Int
  input          String  @db.Text
  expectedOutput String  @db.Text
  explanation    String? @db.Text
  isHidden       Boolean @default(false)

  @@unique([problemId, testIndex])
}

model Module {
  id                   String                @id @default(uuid())
  order                Int                   @unique
  title                String
  description          String?
  isActive             Boolean               @default(true)
  status               String                @default("PUBLISHED")
  approvalStatus       String                @default("APPROVED")
  submittedForReviewAt DateTime?
  submittedForReviewBy String?
  publishedAt          DateTime?
  publishedBy          String?
  reviewNotes          String?               @db.Text
  createdBy            String?
  updatedBy            String?
  learningUnits        LearningUnit[]
  contentManagerScopes ContentManagerScope[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
}

model LearningUnit {
  id                   String                @id @default(uuid())
  moduleId             String
  module               Module                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order                Int
  title                String
  content              String                @db.Text
  codingQuestion       String                @db.Text
  inputFormat          String                @db.Text
  outputFormat         String                @db.Text
  examples             Json
  codeSnippets         Json?
  approach             String?               @db.Text
  readingTimeMinutes   Int                   @default(2)
  isActive             Boolean               @default(true)
  status               String                @default("PUBLISHED")
  approvalStatus       String                @default("APPROVED")
  submittedForReviewAt DateTime?
  submittedForReviewBy String?
  publishedAt          DateTime?
  publishedBy          String?
  reviewNotes          String?               @db.Text
  createdBy            String?
  updatedBy            String?
  problems             Problem[]
  contentManagerScopes ContentManagerScope[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt

  @@index([moduleId])
}

model UserProgress {
  id        String    @id @default(uuid())
  userId    String    @default("guest")
  problemId String
  problem   Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status    String    // "SOLVED" | "ATTEMPTED"
  language  String
  bestCode  String    @db.Text
  solvedAt  DateTime?
  attempts  Int       @default(1)
  xpEarned  Int       @default(0)

  @@unique([userId, problemId, language])
  @@index([userId, problemId])
  @@index([status])
  @@index([userId, status])
}

model Submission {
  id              String   @id @default(uuid())
  userId          String   @default("guest")
  problemId       String
  problem         Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language        String
  code            String   @db.Text
  status          String   // "PASSED" | "FAILED" | "ERROR"
  passedTests     Int
  totalTests      Int      @default(10)
  testResults     Json
  executionTimeMs Int
  createdAt       DateTime @default(now())
  idempotencyKey  String?  @unique

  @@index([userId, problemId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ─── Auth / Identity ──────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  role                     String                    @default("STUDENT") // "STUDENT" | "MENTOR" | "CAMPUS_MANAGER" | "CONTENT_MANAGER" | "ADMIN" | "SUPERADMIN"
  status                   String                    @default("ACTIVE")  // "ACTIVE" | "INACTIVE"
  name                     String?
  // Legacy self-join kept for backward compatibility; new code uses mentor_students table
  mentorId                 String?
  mentor                   User?                     @relation("StudentMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  students                 User[]                    @relation("StudentMentor")
  // Dedicated profile relations
  studentProfile           Student?
  mentorProfile            Mentor?
  campusManagerProfile     CampusManager?
  contentManagerProfile    ContentManager?
  contentManagerAssignment ContentManagerAssignment?
  campusId                 String?                   @map("campus_id")
  campus         Campus?   @relation("CampusUsers", fields: [campusId], references: [id], onDelete: SetNull)
  managedCampuses Campus[] @relation("CampusManager")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([mentorId])
  @@map("users")
}

// ─── Dedicated Profile Tables ─────────────────────────────────────────────────

model Student {
  id          String          @id @default(uuid())
  userId      String          @unique @map("user_id")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  email       String?
  studentCode String          @unique @map("student_code") @db.VarChar(20)
  campusId    String?         @map("campus_id")
  campus      Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  status      String          @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  mentorLinks MentorStudent[]

  @@index([userId])
  @@index([status])
  @@map("students")
}

model Mentor {
  id           String          @id @default(uuid())
  userId       String          @unique @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  email        String?
  mentorCode   String          @unique @map("mentor_code") @db.VarChar(20)
  campusId     String?         @map("campus_id")
  campus       Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  maxStudents  Int             @default(30) @map("max_students")
  status       String          @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  studentLinks MentorStudent[]

  @@index([userId])
  @@map("mentors")
}

model CampusManager {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  email       String?
  managerCode String?  @unique @map("manager_code") @db.VarChar(30)
  department  String?
  designation String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([email])
  @@map("campus_managers")
}

model ContentManager {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  email       String?
  managerCode String?  @unique @map("manager_code") @db.VarChar(30)
  department  String?
  designation String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([email])
  @@map("content_managers")
}

// ─── Mentor ↔ Student Relationship ───────────────────────────────────────────

model MentorStudent {
  id           String    @id @default(uuid())
  mentorId     String    @map("mentor_id")
  mentor       Mentor    @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  studentId    String    @map("student_id")
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // ACTIVE = current assignment; INACTIVE = historical (unassigned)
  status       String    @default("ACTIVE") @db.VarChar(20)
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([mentorId, studentId], name: "uq_mentor_student")
  @@index([mentorId])
  @@index([studentId])
  @@index([status])
  @@map("mentor_students")
}

// ─── Feedback & Reporting ───────────────────────────────────────────────────

model FeedbackReport {
  id                String    @id @default(uuid())
  publicReference   String    @unique @default(dbgenerated("'FB-' || nextval('feedback_public_ref_seq')")) @map("public_reference") @db.VarChar(30)
  userId            String?   @map("user_id")
  userNameSnapshot  String?   @map("user_name_snapshot")
  userEmailSnapshot String    @map("user_email_snapshot") @db.VarChar(255)
  userRole          String    @map("user_role") @db.VarChar(50)
  portal            String    @db.VarChar(50)
  type              String    @db.VarChar(50) // "BUG" | "FEATURE" | "FEEDBACK" | "ISSUE" | "IMPROVEMENT" | "OTHER"
  title             String?   @db.VarChar(255)
  description       String    @db.Text
  rating            String?   @db.VarChar(20)
  featureArea       String?   @map("feature_area") @db.VarChar(255)
  status            String    @default("OPEN") @db.VarChar(30) // "OPEN" | "TRIAGED" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  priority          String    @default("MEDIUM") @db.VarChar(20) // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  pageUrl           String?   @map("page_url") @db.Text
  route             String?   @db.VarChar(255)
  module            String?   @db.VarChar(100)
  attachmentUrl     String?   @map("attachment_url") @db.Text
  attachmentMeta    Json?     @map("attachment_meta")
  deviceInfo        Json?     @map("device_info")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  resolvedAt        DateTime? @map("resolved_at")

  // TeamSync Integration (Phase 3 & 4)
  teamSyncId           String?   @map("teamsync_id") @db.VarChar(100)
  teamSyncTicketNumber String?   @map("teamsync_ticket_number") @db.VarChar(50)
  teamSyncStatus       String?   @default("PENDING") @map("teamsync_status") @db.VarChar(30)
  teamSyncAttempts     Int       @default(0) @map("teamsync_attempts")
  teamSyncLastAttempt  DateTime? @map("teamsync_last_attempt")
  teamSyncError        String?   @map("teamsync_error") @db.Text
  assignedTo           String?   @map("assigned_to") @db.VarChar(255)
  assignedEmail        String?   @map("assigned_email") @db.VarChar(255)
  lastSyncedAt         DateTime? @map("last_synced_at")

  comments             FeedbackComment[]
  auditLogs            FeedbackAuditLog[]
  webhookEvents        TeamSyncWebhookEvent[]

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([publicReference])
  @@index([teamSyncStatus])
  @@index([teamSyncId])
  @@map("feedback_reports")
}

// ─── TeamSync Webhook & Audit System (Phase 4) ────────────────────────────────

model TeamSyncWebhookEvent {
  id               String          @id @default(uuid())
  eventId          String          @unique @map("event_id") @db.VarChar(100)
  eventType        String          @map("event_type") @db.VarChar(50)
  ticketId         String?         @map("ticket_id") @db.VarChar(100)
  ticketNumber     String?         @map("ticket_number") @db.VarChar(50)
  feedbackReportId String?         @map("feedback_report_id")
  feedbackReport   FeedbackReport? @relation(fields: [feedbackReportId], references: [id], onDelete: SetNull)
  payload          Json
  payloadHash      String?         @map("payload_hash") @db.VarChar(64)
  status           String          @default("PROCESSED") @db.VarChar(30) // "PROCESSED" | "IGNORED_DUPLICATE" | "FAILED" | "UNMAPPED_TICKET"
  error            String?         @db.Text
  receivedAt       DateTime        @default(now()) @map("received_at")
  processedAt      DateTime?       @map("processed_at")

  @@index([eventId])
  @@index([ticketId])
  @@index([feedbackReportId])
  @@index([status])
  @@map("teamsync_webhook_events")
}

model FeedbackComment {
  id                String         @id @default(uuid())
  feedbackReportId  String         @map("feedback_report_id")
  feedbackReport    FeedbackReport @relation(fields: [feedbackReportId], references: [id], onDelete: Cascade)
  source            String         @default("TEAMSYNC") @db.VarChar(50) // "TEAMSYNC" | "USER" | "STAFF"
  teamSyncCommentId String?        @unique @map("teamsync_comment_id") @db.VarChar(100)
  authorName        String         @map("author_name") @db.VarChar(255)
  authorEmail       String?        @map("author_email") @db.VarChar(255)
  authorRole        String?        @map("author_role") @db.VarChar(50)
  content           String         @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([feedbackReportId])
  @@index([teamSyncCommentId])
  @@map("feedback_comments")
}

model FeedbackAuditLog {
  id               String          @id @default(uuid())
  feedbackReportId String          @map("feedback_report_id")
  feedbackReport   FeedbackReport  @relation(fields: [feedbackReportId], references: [id], onDelete: Cascade)
  source           String          @default("TEAMSYNC_WEBHOOK") @db.VarChar(50)
  eventId          String?         @map("event_id") @db.VarChar(100)
  action           String          @db.VarChar(50) // "STATUS_CHANGED" | "PRIORITY_CHANGED" | "COMMENT_ADDED" | "ASSIGNED" | "RESOLVED" | "REOPENED"
  previousValue    Json?           @map("previous_value")
  newValue         Json?           @map("new_value")
  details          String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")

  @@index([feedbackReportId])
  @@index([eventId])
  @@index([action])
  @@map("feedback_audit_logs")
}

// ─── TeamSync Outbound Webhook Deliveries (Phase 4B) ──────────────────────────

model TeamSyncWebhookDelivery {
  id                String    @id @default(uuid())
  eventId           String    @unique @map("event_id") @db.VarChar(100)
  eventType         String    @map("event_type") @db.VarChar(50)
  ticketId          String?   @map("ticket_id") @db.VarChar(100)
  ticketNumber      String?   @map("ticket_number") @db.VarChar(50)
  sourceReferenceId String?   @map("source_reference_id") @db.VarChar(50)
  destination       String    @db.VarChar(500)
  payload           Json
  status            String    @default("PENDING") @db.VarChar(30) // "PENDING" | "DELIVERED" | "FAILED" | "RETRYING"
  attemptCount      Int       @default(0) @map("attempt_count")
  httpStatus        Int?      @map("http_status")
  lastAttempt       DateTime? @map("last_attempt")
  nextRetry         DateTime? @map("next_retry")
  error             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")

  @@index([eventId])
  @@index([ticketId])
  @@index([status])
  @@index([createdAt])
  @@map("teamsync_webhook_deliveries")
}

// ─── Campus Infrastructure ───────────────────────────────────────────────────

model Campus {
  id          String    @id @default(uuid())
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(255)
  city        String?   @db.VarChar(100)
  state       String?   @db.VarChar(100)
  country     String?   @default("India") @db.VarChar(100)
  status      String    @default("ACTIVE") @db.VarChar(20)
  managerId   String?   @map("manager_id")
  manager     User?     @relation("CampusManager", fields: [managerId], references: [id], onDelete: SetNull)
  users       User[]    @relation("CampusUsers")
  students    Student[]
  mentors     Mentor[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status])
  @@index([managerId])
  @@map("campuses")
}


// ─── Content Manager RBAC & Audit ─────────────────────────────────────────────

model ContentManagerAssignment {
  id               String                     @id @default(uuid())
  userId           String                     @unique @map("user_id")
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousRole     String                     @default("STUDENT") @map("previous_role") @db.VarChar(50)
  scopeType        String                     @default("GLOBAL") @map("scope_type") @db.VarChar(20) // Unified access: "GLOBAL" (legacy "NONE" | "SCOPED" supported in DB)
  status           String                     @default("ACTIVE") @db.VarChar(20) // "ACTIVE" | "SUSPENDED" | "INVITED" | "REVOKED"
  isActive         Boolean                    @default(true) @map("is_active")
  grantedBy        String?                    @map("granted_by") @db.VarChar(255)
  grantedAt        DateTime                   @default(now()) @map("granted_at")
  invitedBy        String?                    @map("invited_by") @db.VarChar(255)
  invitedAt        DateTime?                  @map("invited_at")
  suspendedBy      String?                    @map("suspended_by") @db.VarChar(255)
  suspendedAt      DateTime?                  @map("suspended_at")
  suspensionReason String?                    @map("suspension_reason") @db.Text
  revokedBy        String?                    @map("revoked_by") @db.VarChar(255)
  revokedAt        DateTime?                  @map("revoked_at")
  updatedBy        String?                    @map("updated_by") @db.VarChar(255)
  notes            String?                    @db.Text
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @default(now()) @updatedAt @map("updated_at")
  permissions      ContentManagerPermission[]
  scopes           ContentManagerScope[]

  @@index([isActive])
  @@index([status])
  @@index([scopeType])
  @@map("content_manager_assignments")
}

model ContentManagerPermission {
  id           String                   @id @default(uuid())
  assignmentId String                   @map("assignment_id")
  assignment   ContentManagerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  permission   String                   @db.VarChar(100)
  grantedAt    DateTime                 @default(now()) @map("granted_at")

  @@unique([assignmentId, permission], name: "uq_cm_assignment_permission")
  @@index([assignmentId])
  @@index([permission])
  @@map("content_manager_permissions")
}

model ContentManagerScope {
  id             String                   @id @default(uuid())
  assignmentId   String                   @map("assignment_id")
  assignment     ContentManagerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  moduleId       String?                  @map("module_id")
  module         Module?                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  learningUnitId String?                  @map("learning_unit_id")
  learningUnit   LearningUnit?            @relation(fields: [learningUnitId], references: [id], onDelete: Cascade)
  createdAt      DateTime                 @default(now()) @map("created_at")

  @@unique([assignmentId, moduleId], name: "uq_cm_assignment_module")
  @@unique([assignmentId, learningUnitId], name: "uq_cm_assignment_unit")
  @@index([assignmentId])
  @@index([moduleId])
  @@index([learningUnitId])
  @@map("content_manager_scopes")
}

model ContentAuditLog {
  id             String   @id @default(uuid())
  actorUserId    String   @map("actor_user_id")
  actorEmail     String   @map("actor_email") @db.VarChar(255)
  actorRole      String   @map("actor_role") @db.VarChar(50)
  action         String   @db.VarChar(100)
  resourceType   String   @map("resource_type") @db.VarChar(50)
  resourceId     String?  @map("resource_id")
  resourceLabel  String?  @map("resource_label")
  permissionUsed String?  @map("permission_used") @db.VarChar(100)
  previousValues Json?    @map("previous_values")
  updatedValues  Json?    @map("updated_values")
  changeSummary  String?  @map("change_summary") @db.Text
  ipAddress      String?  @map("ip_address") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@index([createdAt(sort: Desc)])
  @@map("content_audit_logs")
}
