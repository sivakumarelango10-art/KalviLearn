# Supabase Configuration (Vite Client)
VITE_SUPABASE_URL=https://iavxnhwbgoarnexmyxpn.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_APP_URL=https://kalvilearn.vercel.app

# Server-only (NEVER prefix with VITE_ / NEXT_PUBLIC_). REQUIRED in production: the API handlers refuse to start
# without them (no silent fallback to the public anon key).
SUPABASE_URL=https://iavxnhwbgoarnexmyxpn.supabase.co
# Preferred modern server-side secret key:
SUPABASE_SECRET_KEY=your_server_side_secret_key
# Backward-compatible fallback:
SUPABASE_SERVICE_ROLE_KEY=your_server_side_service_role_key

# CORS allow-list for the API (comma separated origins). The production app origin is always allowed;
# localhost dev origins are allowed automatically outside production. Never use "*".
ALLOWED_ORIGINS=https://kalvilearn.vercel.app

# Next.js / Server Environment Compatibility
NEXT_PUBLIC_SUPABASE_URL=https://iavxnhwbgoarnexmyxpn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Database Connection URLs (Prisma)
DATABASE_URL="postgresql://postgres.your_project:password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your_project:password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# TeamSync Server-to-Server Integration (Phase 3 & Phase 4)
TEAMSYNC_API_URL=https://api.teamsync.internal
TEAMSYNC_API_KEY=your_server_side_teamsync_secret
TEAMSYNC_WEBHOOK_SECRET=your_server_side_teamsync_webhook_secret

# TeamSync Webhook Sender to KalviLearn (Phase 4B)
KALVILEARN_WEBHOOK_URL=https://kalvilearn.vercel.app/api/integrations/teamsync/webhooks
KALVILEARN_WEBHOOK_SECRET=your_server_side_webhook_secret

